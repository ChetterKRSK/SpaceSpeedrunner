[sub_resource type="GDScript" id="GDScript_0q2ys"]
script/source = "extends Control

@onready var orbitName: Label = $VBoxContainer/OrbitName
@onready var turnoverTime: Label = $VBoxContainer/TurnoverTime


var GM: Node2D

var orbitNameText: String
var currentPosition: Vector2
var planet: int


func _ready() -> void:
	GM = get_node(\"/root/GameScene\")

func adjust():
	updateUI()
	var tween: Tween = get_tree().create_tween()
	tween.tween_property(self, \"scale\", Vector2(1 / GM.mainCamera.zoom.x, 1 / GM.mainCamera.zoom.x), 0.25)
	global_position.x = currentPosition.x
	global_position.y = currentPosition.y - get_global_rect().size.y
	if global_position.x < GM.mainCamera.limit_left:
		global_position.x = currentPosition.x + GM.mainCamera.limit_left - global_position.x
	if global_position.x + get_global_rect().size.x > GM.mainCamera.limit_right:
		global_position.x = currentPosition.x - (global_position.x + get_global_rect().size.x - GM.mainCamera.limit_right)
	if global_position.y < GM.mainCamera.limit_top:
		global_position.y = currentPosition.y + GM.mainCamera.limit_top - global_position.y - get_global_rect().size.y
	if global_position.y + get_global_rect().size.y > GM.mainCamera.limit_bottom:
		global_position.y = currentPosition.y - (global_position.y + get_global_rect().size.y - GM.mainCamera.limit_bottom)

func updateUI():
	orbitName.text = \"Орбита \" + get_tree().get_nodes_in_group(\"planets\")[planet].planetName.to_lower()
	
	var planetPath: PathFollow2D = get_tree().get_nodes_in_group(\"planetPathFollows\")[planet]
	var Bpos: Vector2 = currentPosition
	
	var radB = atan2(Bpos.y, Bpos.x)
	if radB < 0: radB += 2 * PI
	var prB = 1 - (radB / (2 * PI))
	
	var speed
	var raz
	var timeB
	if GM.planetOrbitSpeed[planet] > 0:
		speed = ((0.1/6) / GM.planetOrbitSpeed[planet]) * 60
		raz = prB - planetPath.progress_ratio
		if raz < 0: raz = 1 + raz
		timeB = speed * (raz)
	else:
		speed = ((0.1/6) / -GM.planetOrbitSpeed[planet]) * 60
		raz = planetPath.progress_ratio - prB
		if raz < 0: raz = 1 + raz
		timeB = speed * (raz)
	
	var minutes = int(timeB / 60)
	var seconds = int(timeB) - (minutes * 60)
	var strTimer: String = str(minutes) if minutes >= 10 else \"0\" + str(minutes)
	strTimer += \":\"
	strTimer += str(seconds) if seconds >= 10 else \"0\" + str(seconds)
	
	turnoverTime.text = \"Планета через: %s\" % strTimer

func showWindow(newPosition):
	currentPosition = newPosition
	position = newPosition
	visible = true

func hideWindow():
	var tween: Tween = get_tree().create_tween()
	tween.tween_property(self, \"scale\", Vector2(), 0.25)
	await tween.finished
	visible = false
"

