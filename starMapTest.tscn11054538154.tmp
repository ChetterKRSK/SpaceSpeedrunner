[sub_resource type="GDScript" id="GDScript_7l8cf"]
script/source = "extends Node2D

@export var Paths: Array
@export var a: Array

func _ready() -> void:
	for path in Paths:
		%path.progress_ratio = randf_range(0, 1)


func _process(delta: float) -> void:
	pass
"

